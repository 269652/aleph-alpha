# Godot 4+ specific ignores
.godot/
.import/
# NOT *.import: Godot 4 keeps each asset's import settings and its stable
# UID in a <asset>.png.import file beside the asset, and expects it
# committed. All 877 of this project's .import files ARE tracked -- a
# .gitignore rule never affects files git already follows -- so the rule
# was doing nothing except waiting to swallow the NEXT asset somebody
# added. Removed rather than left as a trap.
*.uid
export.cfg
export_presets.cfg

# The headless Godot build a test run needs. .github/workflows/tests.yml
# downloads the engine to exactly this path, and running the suite the same
# way locally (see CONTRIBUTING.md) lands ~140MB of engine binary in the
# working tree -- close enough to a real source path that a broad `git add`
# would happily commit it.
godot-bin/

# Probe render output. tools/probe_*.gd write their PNGs beside themselves
# (tools/grass_turn_renders/, tools/grass_bend_renders/); the probe SCRIPT is
# the artifact worth keeping -- its images are evidence for one session's own
# finding, recorded in that probe's own header and in docs/, not something to
# re-commit every time somebody re-runs it.
tools/*_renders/

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/

# Licensing private key (see docs/licensing.md) -- generated by
# tools/generate_keypair.gd, holds the FULL keypair (private + public).
# Must NEVER be committed: anyone with this file can mint valid serials
# and re-sign a tampered build. Kept out of git even for the auto-sign-
# for-local-testing convenience, which reads it straight off disk.
private_key.pem
my_private_key.pem
*.pem

# GitHub OAuth App credentials for the personal/GitHub-bound license
# feature (see docs/licensing.md). GITHUB_OAUTH_ID (the Device Flow
# Client ID) is safe to embed in shipped source -- Device Flow is a
# public-client flow specifically so it never needs a secret. Any
# GITHUB_OAUTH_SECRET here is UNUSED by the game and must never be
# committed or embedded: it wasn't generated for this feature, and a
# leaked client_id+secret pair could be used to impersonate this OAuth
# App in a real Authorization Code flow against actual GitHub users.
.env


# Source packs downloaded by tools/prepare_footstep_oneshots.py -- the
# footstep one-shots it builds from them are committed; the multi-megabyte
# archives they came out of are not.
.cache/
